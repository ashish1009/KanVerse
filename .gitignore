# User-Specific Xcode Settings (Never commit personal IDE state)
# ==============================================================================
*.xcuserstate
project.xcworkspace/xcuserdata/
*.xcuserdatad
*.xcscmblueprint

# Keep shared schemes and shared workspace data intact
!default.mode1v3
!default.mode2v3
!default.pbxuser
!default.perspectivev3
!xcuserdata

